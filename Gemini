use std::sync::{Arc, Mutex};
use std::thread;
use std::time::Duration;

// A shared resource for the unsynchronized demonstration.
// In safe Rust, concurrent access to a mutable static variable is forbidden.
// We must use 'unsafe' to force the data race.
static mut UNSYNC_COUNTER: i32 = 0;

fn main() {
    println!("==================================================");
    println!("1. THREAD CREATION DEMONSTRATION");
    println!("==================================================\n");
    demo_thread_creation();

    println!("\n==================================================");
    println!("2. UNSYNCHRONIZED VS SYNCHRONIZED DEMONSTRATION");
    println!("==================================================\n");
    demo_sync_vs_unsync();

    println!("\n==================================================");
    println!("3. THREAD PRIORITY & SCHEDULING INVESTIGATION");
    println!("==================================================\n");
    demo_priority_investigation();
}

/// ---------------------------------------------------------
/// PART 1: Thread Creation
/// ---------------------------------------------------------
fn demo_thread_creation() {
    let mut handles = vec![];

    // Thread 1: Math Operations
    handles.push(thread::spawn(|| {
        println!("[Thread 1 - Math] Started.");
        let result = 100 * 42;
        thread::sleep(Duration::from_millis(50));
        println!("[Thread 1 - Math] Work complete: 100 * 42 = {}", result);
        println!("[Thread 1 - Math] Finished.");
    }));

    // Thread 2: String Manipulation
    handles.push(thread::spawn(|| {
        println!("[Thread 2 - String] Started.");
        let reversed: String = "Concurrency".chars().rev().collect();
        thread::sleep(Duration::from_millis(70));
        println!("[Thread 2 - String] Work complete: Reversed string is '{}'", reversed);
        println!("[Thread 2 - String] Finished.");
    }));

    // Thread 3: Simulated IO
    handles.push(thread::spawn(|| {
        println!("[Thread 3 - IO Sim] Started.");
        thread::sleep(Duration::from_millis(150)); // Simulating a slower disk read
        println!("[Thread 3 - IO Sim] Work complete: Read 1024 bytes from virtual disk.");
        println!("[Thread 3 - IO Sim] Finished.");
    }));

    // Thread 4: Data Processing
    handles.push(thread::spawn(|| {
        println!("[Thread 4 - Array] Started.");
        let mut numbers = [5, 2, 9, 1, 3];
        numbers.sort();
        thread::sleep(Duration::from_millis(60));
        println!("[Thread 4 - Array] Work complete: Sorted array {:?}", numbers);
        println!("[Thread 4 - Array] Finished.");
    }));

    // Thread 5: Background Timer
    handles.push(thread::spawn(|| {
        println!("[Thread 5 - Timer] Started.");
        for i in 1..=3 {
            thread::sleep(Duration::from_millis(40));
            println!("[Thread 5 - Timer] Tick {}...", i);
        }
        println!("[Thread 5 - Timer] Finished.");
    }));

    // Wait for all threads to finish
    for handle in handles {
        handle.join().unwrap();
    }
}

/// ---------------------------------------------------------
/// PART 2: Unsynchronized vs Synchronized
/// ---------------------------------------------------------
fn demo_sync_vs_unsync() {
    let num_threads = 10;
    let increments_per_thread = 100_000;

    println!("--- Running UNSYNCHRONIZED phase ---");
    let mut unsync_handles = vec![];
    
    for _ in 0..num_threads {
        unsync_handles.push(thread::spawn(move || {
            for _ in 0..increments_per_thread {
                // We use unsafe to intentionally bypass Rust's borrow checker 
                // and create a classic data race.
                unsafe {
                    let temp = UNSYNC_COUNTER;
                    // A tiny artificial delay to widen the race condition window
                    // (Omitted here to let standard CPU interleaving do the work)
                    UNSYNC_COUNTER = temp + 1;
                }
            }
        }));
    }

    for h in unsync_handles {
        h.join().unwrap();
    }

    unsafe {
        let expected = num_threads * increments_per_thread;
        println!("Expected counter value: {}", expected);
        println!("Actual counter value:   {}", UNSYNC_COUNTER);
        println!("Lost updates:           {}", expected - UNSYNC_COUNTER);
    }

    println!("\n--- Running SYNCHRONIZED phase ---");
    // Arc (Atomic Reference Count) allows multiple threads to own the Mutex.
    // Mutex ensures only one thread can access the data at a time.
    let sync_counter = Arc::new(Mutex::new(0));
    let mut sync_handles = vec![];

    for _ in 0..num_threads {
        let counter_clone = Arc::clone(&sync_counter);
        sync_handles.push(thread::spawn(move || {
            for _ in 0..increments_per_thread {
                // Lock the mutex. This blocks until the lock is acquired.
                let mut num = counter_clone.lock().unwrap();
                *num += 1;
                // Mutex is automatically unlocked when `num` goes out of scope here.
            }
        }));
    }

    for h in sync_handles {
        h.join().unwrap();
    }

    let final_val = *sync_counter.lock().unwrap();
    println!("Expected counter value: {}", num_threads * increments_per_thread);
    println!("Actual counter value:   {}", final_val);
    if final_val == (num_threads * increments_per_thread) {
        println!("Success! No updates were lost.");
    }
}

/// ---------------------------------------------------------
/// PART 3: Thread Priority and Scheduling Behavior
/// ---------------------------------------------------------
fn demo_priority_investigation() {
    println!("Spawning 3 intensive computational threads simultaneously...");
    
    // In standard Rust, there is NO native API to set thread priorities.
    // We will launch three identical CPU-bound threads and observe the OS scheduling.
    
    let mut handles = vec![];
    
    for id in 1..=3 {
        handles.push(thread::spawn(move || {
            println!("[Priority-Test Thread {}] Started computing.", id);
            let mut _dummy_sum: u64 = 0;
            // A long, meaningless loop to consume CPU time
            for i in 0..50_000_000 {
                _dummy_sum = _dummy_sum.wrapping_add(i);
            }
            println!("[Priority-Test Thread {}] Finished computing.", id);
        }));
    }

    for h in handles {
        h.join().unwrap();
    }
    
    println!("\nPriority Investigation Complete.");
}